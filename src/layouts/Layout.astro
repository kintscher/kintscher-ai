---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import CommandPalette from '../components/CommandPalette.astro';

interface Props {
  title?: string;
  description?: string;
  path?: string;
}

const {
  title = 'Yannik Kintscher — Fullstack engineer in Zürich',
  description = 'Fullstack engineer in Zürich. GenAI, conversational banking, internal tooling at UBS.',
  path = Astro.url.pathname,
} = Astro.props;

const canonical = `https://kintscher.ai${path}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, interactive-widget=resizes-content" />
    <meta name="theme-color" content="#0B0B0E" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="kintscher.ai" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content="https://kintscher.ai/og.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Yannik Kintscher — Fullstack engineer in Zürich" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://kintscher.ai/og.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500&family=Geist+Mono:wght@400;500&family=Instrument+Serif:ital@0;1&display=swap"
    />

    <ClientRouter />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <SiteHeader />
    <main id="main"><slot /></main>
    <SiteFooter />
    <CommandPalette />

    <script>
      // Amber rule sweep across the viewport on every view transition.
      // Idempotent: registers listeners once per document load.
      type SweepWindow = Window & {
        __kSweepBound?: boolean;
        __kShortcutsBound?: boolean;
      };
      const w = window as SweepWindow;
      if (!w.__kSweepBound) {
        w.__kSweepBound = true;
        document.addEventListener('astro:after-swap', () => {
          const sweep = document.createElement('div');
          sweep.className = 'page-sweep';
          document.body.appendChild(sweep);
          sweep.addEventListener('animationend', () => sweep.remove(), { once: true });
        });
      }

      // Single-letter keyboard shortcuts. The site advertises these via
      // <kbd> hints in the header and command palette - making them real
      // is the keyboard-first principle the site claims.
      //
      // Gates: skip when a field is focused, when any modifier is held
      // (Cmd/Ctrl/Alt - leave native shortcuts alone), and when a dialog
      // (the command palette) is open. The palette has its own listener
      // for ⌘K / / / Esc and consumes events before they reach here.
      if (!w.__kShortcutsBound) {
        w.__kShortcutsBound = true;
        const SHORTCUTS: Record<string, () => void> = {
          h: () => { location.href = '/'; },
          a: () => { location.href = '/about'; },
          c: () => { location.href = '/chat'; },
          x: () => { location.href = '/contact'; },
          e: () => { location.href = 'mailto:yannik@kintscher.ai'; },
          g: () => {
            window.open(
              'https://github.com/kintscher',
              '_blank',
              'noopener,noreferrer',
            );
          },
          l: () => {
            window.open(
              'https://www.linkedin.com/in/yannik-kintscher',
              '_blank',
              'noopener,noreferrer',
            );
          },
        };

        document.addEventListener('keydown', (e: KeyboardEvent) => {
          if (e.metaKey || e.ctrlKey || e.altKey) return;
          const tgt = e.target as HTMLElement | null;
          if (
            tgt &&
            (tgt.matches('input, textarea, select') || tgt.isContentEditable)
          ) {
            return;
          }
          if (document.querySelector('dialog[open]')) return;
          const fn = SHORTCUTS[e.key.toLowerCase()];
          if (!fn) return;
          e.preventDefault();
          fn();
        });
      }
    </script>
  </body>
</html>
